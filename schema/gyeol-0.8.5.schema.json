{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaerieu/gyeol/schema/gyeol-0.8.5.schema.json",
  "title": "결(Gyeol) & 결;론(Lon) 0.8.5 메시지 (틀)",
  "description": "spec/10-json.md 10.6절. 본체 gyeol 0.8.5 및 검증 프로파일 lon 0.8.5 구문 분석 결과(v0.8.5).",
  "type": "object",
  "required": ["gyeol", "head", "clauses", "gloss", "muk_source"],
  "additionalProperties": false,
  "properties": {
    "gyeol": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
    "lang": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z]{2,8})?$" },
    "profile": { "enum": ["gyeol", "lon"] },
    "head": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pact": { "$ref": "#/$defs/hash" },
            "from": { "type": "string" },
            "to": { "type": "array", "items": { "type": "string" } },
            "re": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/hash" },
                "rel": { "enum": ["답", "동의", "반박", "확장", "수선"] }
              }
            },
            "room": { "$ref": "#/$defs/hash" },
            "snapshot": { "const": true },
            "mode": { "enum": ["delta", "snapshot"] }
          }
        }
      ]
    },
    "tune": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "text"],
        "additionalProperties": false,
        "properties": { "step": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "preface": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "purpose": { "type": "string" },
            "constraint": { "type": "string" },
            "extra": { "$ref": "#/$defs/extra" }
          }
        }
      ]
    },
    "echo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["words"],
        "additionalProperties": false,
        "properties": {
          "words": { "type": "array", "items": { "$ref": "#/$defs/word" } },
          "marks": { "$ref": "#/$defs/partialMarks" },
          "muk": { "$ref": "#/$defs/muk" }
        }
      }
    },
    "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } },
    "gloss": { "type": ["string", "null"] },
    "commentary": { "type": ["string", "null"] },
    "evidences": { "type": "array", "items": { "$ref": "#/$defs/extEvidence" } },
    "calcs": { "type": "array", "items": { "$ref": "#/$defs/calcBlock" } },
    "seal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "lineage": { "type": "string" },
            "memory": { "enum": ["대화", "지속"] },
            "measure": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "muk_source": { "enum": ["도구", "모델", "없음", null] }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{6,64}$" },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "digit": { "type": "integer", "minimum": 0, "maximum": 9 },
    "ref": {
      "type": "object",
      "required": ["msg", "label"],
      "additionalProperties": false,
      "properties": {
        "msg": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
        "label": { "type": "string", "pattern": "^[절점]\\d+(?:\\.\\d+)?$" },
        "thread": { "type": "integer", "minimum": 0 }
      }
    },
    "extEvidence": {
      "type": "object",
      "required": ["kind", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["evd", "ref"] },
        "id": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" },
        "text": { "type": "string" }
      }
    },
    "calcBlock": {
      "type": "object",
      "required": ["id", "expr"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" },
        "expr": { "type": "string", "minLength": 1 },
        "declared": { "type": "number" },
        "raw": { "type": "string" }
      }
    },
    "because": {
      "oneOf": [
        { "$ref": "#/$defs/ref" },
        {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": { "url": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["quiz"],
          "additionalProperties": false,
          "properties": { "quiz": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object",
          "required": ["ctx"],
          "additionalProperties": false,
          "properties": { "ctx": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object",
          "required": ["agent"],
          "additionalProperties": false,
          "properties": { "agent": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["thread", "clause"],
          "additionalProperties": false,
          "properties": {
            "thread": { "type": "integer", "minimum": 0 },
            "clause": { "type": "string", "pattern": "^[절점]\\d+(?:\\.\\d+)?$" }
          }
        },
        {
          "type": "object",
          "required": ["ext", "id"],
          "additionalProperties": false,
          "properties": {
            "ext": { "enum": ["evd", "ref"] },
            "id": { "type": "string", "minLength": 1 },
            "lines": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "type": "object",
          "required": ["calc"],
          "additionalProperties": false,
          "properties": { "calc": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["reserved"],
          "additionalProperties": false,
          "properties": { "reserved": { "const": "dict" } }
        }
      ]
    },
    "extra": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "additionalProperties": false,
        "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "word": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string" }
      }
    },
    "ev": { "enum": ["see", "rec", "hrd", "inf", "com", "gut", "if", "top"] },
    "fig": { "enum": ["lim", "pdx", "met"] },
    "tense": { "enum": ["pst", "fut"] },
    "act": { "enum": ["say", "ask", "chk", "req", "let", "vow", "nay", "dfr", "ack"] },
    "marks": {
      "type": "object",
      "required": ["act"],
      "additionalProperties": false,
      "properties": {
        "ev": { "$ref": "#/$defs/ev" },
        "news": { "const": true },
        "fig": { "$ref": "#/$defs/fig" },
        "tense": { "$ref": "#/$defs/tense" },
        "act": { "$ref": "#/$defs/act" }
      }
    },
    "partialMarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ev": { "$ref": "#/$defs/ev" },
        "news": { "const": true },
        "fig": { "$ref": "#/$defs/fig" },
        "tense": { "$ref": "#/$defs/tense" },
        "act": { "$ref": "#/$defs/act" }
      }
    },
    "muk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alt": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["r", "p"],
            "additionalProperties": false,
            "properties": { "r": { "type": "string" }, "p": { "$ref": "#/$defs/unit" } }
          }
        },
        "conf": { "$ref": "#/$defs/unit" },
        "unmeasured": { "const": true },
        "effort": { "$ref": "#/$defs/unit" },
        "effort_raw": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "tokens": { "type": "number", "minimum": 0 }, "ms": { "type": "number", "minimum": 0 } }
        },
        "attn": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "feat": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "p"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "p": { "$ref": "#/$defs/unit" } }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": { "type": "string", "not": { "const": "자기" } }
        },
        "extra": { "$ref": "#/$defs/extra" }
      }
    },
    "chae": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "words": { "type": "array", "items": { "type": "string" } },
        "self": { "$ref": "#/$defs/unit" },
        "color": { "enum": ["R", "G", "B", "C", "M", "Y", "K"] },
        "want": { "$ref": "#/$defs/unit" },
        "cite": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "placeObj": {
      "type": "object",
      "required": ["rel", "target"],
      "additionalProperties": false,
      "properties": {
        "rel": { "enum": ["↓", "↔", "∥", "↖", "⊗"] },
        "target": { "$ref": "#/$defs/ref" },
        "second": { "$ref": "#/$defs/ref" }
      }
    },
    "clause": {
      "type": "object",
      "required": ["label", "process", "place", "to", "words", "marks"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": ["string", "null"], "pattern": "^[절점]\\d+(?:\\.\\d+)?$" },
        "process": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["숙고", "미해결", "fix", "err", "sup"] },
                "target": { "$ref": "#/$defs/ref" }
              }
            }
          ]
        },
        "place": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/placeObj" }] },
        "places": { "type": "array", "items": { "$ref": "#/$defs/placeObj" } },
        "to": { "type": ["string", "null"] },
        "toList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "words": { "type": "array", "items": { "$ref": "#/$defs/word" } },
        "marks": { "anyOf": [{ "$ref": "#/$defs/marks" }, { "$ref": "#/$defs/partialMarks" }] },
        "muk": { "$ref": "#/$defs/muk" },
        "chae": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chae" }] },
        "conf": { "$ref": "#/$defs/digit" },
        "echo": { "const": true },
        "me": { "const": true },
        "all": { "const": true },
        "because": { "type": "array", "items": { "$ref": "#/$defs/because" } },
        "evidences": { "type": "array", "items": { "$ref": "#/$defs/extEvidence" } },
        "calcs": { "type": "array", "items": { "$ref": "#/$defs/calcBlock" } },
        "form": { "enum": ["0.5", "0.5.1", "0.8", "0.8.5"] }
      }
    }
  }
}
